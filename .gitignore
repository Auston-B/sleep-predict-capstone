# Environment
*.env
dashboard/.streamlit/secrets.toml

# Data — NEVER commit participant data
*.csv
*.parquet
*.feather
*.pkl
data/

# Exception — the aggregate dashboard tables are the only CSVs published.
!dashboard/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Kept locally, not published — regeneration tooling and internal memos
scripts/
reports/analysis_corrections.md

# The synthetic generator mirrors the All of Us schema for local experimentation,
# but nothing in the pipeline reads it and its output is never committed.
synthetic_data/

# The exported poster ships as reports/poster.pdf; everything upstream of it
# stays local, the same way scripts/ does.
poster/

# Built by .github/workflows/deploy-pages.yml
_site/

# OS and editor
.DS_Store
.vscode/
